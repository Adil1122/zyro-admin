# ─── Admin credentials ───────────────────────────────────────────────────────
# The single admin account for this panel.
ADMIN_EMAIL=anes@zyrocloud.com
ADMIN_PASSWORD=your-secure-password-here

# ─── Session secret ───────────────────────────────────────────────────────────
# Random string, min 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-string

# ─── Resend (for email OTP delivery) ─────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# RESEND_FROM must be a verified domain address (e.g. ops@yourdomain.com).
# During testing you can use onboarding@resend.dev to send to your own email only.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Zyro Ops <ops@yourdomain.com>

# ─── Dev note ─────────────────────────────────────────────────────────────────
# If RESEND_API_KEY is left blank, the OTP is printed to the terminal console instead.
# This lets you test the full login flow locally without setting up email.
