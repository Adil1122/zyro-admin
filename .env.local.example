# ─── Admin credentials ───────────────────────────────────────────────────────
# The single admin account for this panel.
ADMIN_EMAIL=anes@zyrocloud.com
ADMIN_PASSWORD=your-secure-password-here

# ─── Session secret ───────────────────────────────────────────────────────────
# Random string, min 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-string

# ─── SMTP (for email OTP delivery) ───────────────────────────────────────────
# Gmail example — use an App Password, not your regular Gmail password.
# Enable at: https://myaccount.google.com/apppasswords
#
# Other providers: Mailgun, SendGrid, Brevo, Resend — just point HOST/PORT/USER/PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM=Zyro Ops <your@gmail.com>

# ─── Dev note ─────────────────────────────────────────────────────────────────
# If SMTP_HOST is left blank, the OTP is printed to the terminal console instead.
# This lets you test the full login flow locally without setting up email.
