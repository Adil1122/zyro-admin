# ─── Admin credentials ───────────────────────────────────────────────────────
# The single admin account for this panel.
ADMIN_EMAIL=anes@zyrocloud.com
ADMIN_PASSWORD=your-secure-password-here

# ─── Session secret ───────────────────────────────────────────────────────────
# Random string, min 32 characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-32-char-string

# ─── Resend (for email OTP delivery) ─────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# RESEND_FROM must be a verified domain address (e.g. ops@yourdomain.com).
# During testing you can use onboarding@resend.dev to send to your own email only.
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM=Zyro Ops <ops@yourdomain.com>

# ─── Dev note ─────────────────────────────────────────────────────────────────
# If RESEND_API_KEY is left blank, the OTP is printed to the terminal console instead.
# This lets you test the full login flow locally without setting up email.

# ─── Supabase ─────────────────────────────────────────────────────────────────
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
# Get from: https://dashboard.stripe.com/webhooks (after creating the webhook endpoint)
# Webhook URL: https://your-domain.vercel.app/api/billing/webhook
# Events to listen for: checkout.session.completed, checkout.session.expired, payment_intent.payment_failed
STRIPE_WEBHOOK_SECRET=whsec_...
# Your deployed URL (used for Stripe redirect URLs)
NEXT_PUBLIC_URL=https://your-domain.vercel.app

# ─── Easypaisa (EasyPay merchant) ─────────────────────────────────────────────
# Get from your Easypaisa merchant portal
EASYPAISA_STORE_ID=your-store-id
EASYPAISA_HASH_KEY=your-hash-key

# ─── JazzCash ──────────────────────────────────────────────────────────────────
# Get from your JazzCash merchant portal
JAZZCASH_MERCHANT_ID=your-merchant-id
JAZZCASH_PASSWORD=your-password
JAZZCASH_INTEGRITY_SALT=your-integrity-salt
